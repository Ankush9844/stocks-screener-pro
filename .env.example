# Copy to .env (never commit .env) for local runs; on Vercel add the same names under Project Settings > Environment Variables.
# Supabase dashboard > Project Settings > API (or the "Connect" button) has all three values.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Public key: the "anon" key (eyJ...) or the newer "publishable" key (sb_publishable_...)
SUPABASE_ANON_KEY=
# Optional, server only, keep secret: the "service_role" key (eyJ...) or a "secret" key (sb_secret_...).
# With it the screener's signal history is kept in Supabase; without it that history stays in a local file.
SUPABASE_SERVICE_ROLE_KEY=
